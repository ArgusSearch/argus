# Copy to .env for local overrides. Never commit .env.
# Optional: enables LLM prose and hypothesis proposals in Stage 2. Argus runs fully without it.
ANTHROPIC_API_KEY=
# Optional: the Argus Agent. off (default) | live (model calls, needs the key) | replay (recorded sessions).
ARGUS_AGENT=off
# Optional: JSONL ledger that gets one line per model and agent run: {"provider","model","usd"}.
ARGUS_SPEND_LEDGER=
# Optional: where `make demo` and the API keep generated worlds and run state.
ARGUS_RUNS_DIR=runs
