# Copy to .env for local overrides. Never commit .env.
# Optional: Anthropic for Stage 2 prose and the live agent.
ANTHROPIC_API_KEY=
# Optional: OpenAI for the live agent. When both keys are set, the agent defaults to OpenAI.
OPENAI_API_KEY=
ARGUS_PROVIDER=
# Optional: the Argus Agent. off (default) | live (model calls) | record (model calls and cassette).
ARGUS_AGENT=off
# Optional: JSONL ledger that gets one line per model and agent run: {"provider","model","usd"}.
ARGUS_SPEND_LEDGER=
# Optional: where `make demo` and the API keep generated worlds and run state.
ARGUS_RUNS_DIR=runs
